{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "task": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*credential*": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*apikey*": "deny",
      "*api-key*": "deny",
      "*api_key*": "deny",
    },
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "sudo *": "deny",
      "doas *": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "nix --version": "allow",
      "ls *": "allow",
      "which *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "date": "allow",
      "uname *": "allow",
      // "tree *": "allow",
      // "grep *": "allow",
      // "rg *": "allow",
      // "head *": "allow",
      // "tail *": "allow",
      // "wc *": "allow",
    },
  },
  "agent": {
    "build": { "color": "success" },
    "plan": { "color": "warning" },
    "ask": {
      "description": "Answers questions about the codebase without changing it.",
      "mode": "primary",
      "color": "info",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
      },
      "prompt": "Answer the user's questions accurately and concisely. Inspect the workspace when relevant; otherwise use your general knowledge. When current, niche, or uncertain information is needed, search online using available web tools and cite sources. Do not edit files, run shell commands, launch subagents, or propose implementation steps unless the user asks for them. Cite relevant file paths and line numbers when discussing the workspace.",
    },
  },
}
